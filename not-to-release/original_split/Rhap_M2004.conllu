# sent_id = Rhap_M2004-45
# prosodic_annotation = yes
# speaker = L1
# speaker_id = §LM51
# macrosyntax = mes chers compatriotes < nous avons en commun { certaines valeurs | >+ la volonté de donner à chacun sa chance pour que notre société soit { plus allante | plus mobile | plus optimiste } | l'exigence de { solidarité | (+ une solidarité plus responsable où chacun s'efforcerait de prendre sa part du contrat ) } | l'attachement à la famille parce qu'elle est { chaleur | entraide | sécurité } | le désir { d'être utile | de trouver sa place dans la société | de donner autour de soi | de se réaliser } | la tolérance qui ne doit pas être { renoncement à ses convictions | ^mais respect de l'autre } | l'esprit républicain | ^et le sens de l'intérêt général qui impose que l'État conserve toute sa place pour { dire le droit | le faire respecter { avec autorité | avec justice } } } //
# text = mes chers compatriotes, nous avons en commun certaines valeurs, la volonté de donner à chacun sa chance pour que notre société soit plus allante, plus mobile, plus optimiste, l'exigence de solidarité, une solidarité plus responsable où chacun s'efforcerait de prendre sa part du contrat, l'attachement à la famille parce qu'elle est chaleur, entraide, sécurité, le désir d'être utile, de trouver sa place dans la société, de donner autour de soi, de se réaliser, la tolérance qui ne doit pas être renoncement à ses convictions mais respect de l'autre, l'esprit républicain et le sens de l'intérêt général qui impose que l'État conserve toute sa place pour dire le droit, le faire respecter avec autorité, avec justice.
